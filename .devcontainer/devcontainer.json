{
  "name": "590 agents",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "mounts": [
    "source=agents590-venv,target=${containerWorkspaceFolder}/.venv,type=volume",
    "source=${localEnv:HOME}/comp590h/agent_evals,target=/workspaces/agent_evals,type=bind"
  ],
  "postCreateCommand": "sudo chown vscode:vscode .venv && uv sync --locked",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ],
      "settings": { "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python" }
    }
  }
}
